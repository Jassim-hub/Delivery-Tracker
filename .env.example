# ==============================================================================
# DELIVERY TRACKER PWA - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Client Environment Variables (Exposed to browser via Vite - Safe values only)
# ------------------------------------------------------------------------------
# Supabase project URL and anon public key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Maps API key (with Referrer & API restriction in Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=AIzaSy...

# Set to "true" to run against realistic local mock data without live Supabase
VITE_USE_MOCK_BACKEND=true

# SAP Business ByDesign Adapter switch ("true" = Mock Adapter, "false" = Real OData client)
VITE_SAP_BYD_USE_MOCK=true


# Server / Supabase Edge Functions Only (NEVER expose to frontend client)
# ------------------------------------------------------------------------------
# Supabase Service Role Key for administrative bypass / backend workers
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Self-generated Web Push VAPID keys (Generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=BG...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:admin@deliverytracker.com

# Real SAP Business ByDesign Tenant Configuration (OData v2)
SAP_BYD_BASE_URL=https://myXXXXXX.businessbydesign.cloud.sap
SAP_BYD_AUTH_TOKEN=Basic YWRtaW46cGFzc3dvcmQ=
